{
  "name": "hostelz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "run-p -l dev:*",
    "dev:api": "bun --watch src/api.ts",
    "dev:test": "find test/*.gleam src/*.gleam | entr gleam test",
    "dev:vite": "vite",
    "build": "run-s build:*",
    "build:db": "bun db migrate",
    "build:vite": "vite build",
    "build:api": "bun build src/api.ts --target bun --outfile dist/api/index.js",
    "build:gleam": "gleam build",
    "db": "graphile-migrate",
    "test": "run-s test:*",
    "test:db": "bun --env-file=.env.test db migrate",
    "test:gleam": "bun --env-file=.env.test gleam test"
  },
  "devDependencies": {
    "@chouquette/gleam": "^1.16.0",
    "graphile-migrate": "^1.4.1",
    "npm-run-all": "^4.1.5",
    "ts-gleam": "^1.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vite-gleam": "^1.7.1"
  }
}
